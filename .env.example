# ================================================================
# FRIDAY AI Desktop Companion - Environment Variables Example
# Copy this file to '.env' and fill in your own Google Gemini API key.
# NEVER commit your actual .env file with real keys to Git!
# ================================================================

# Required: Google Gemini API Key
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default AI Model (defaults to gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional: Preferred Default Language (te-IN, en-IN, hi-IN, ta-IN, kn-IN, en-US)
DEFAULT_LANGUAGE=te-IN

# Optional: ElevenLabs backend-only TTS key (never expose this to the renderer).
# For the packaged app, place the filled .env at:
# %APPDATA%\friday-ai-companion\.env
# Create a restricted key with Text-to-Speech and User/Subscription read access.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional ElevenLabs defaults
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here
ELEVENLABS_MODEL=eleven_flash_v2_5
