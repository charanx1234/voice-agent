{
  "appId": "com.friday.ai.companion",
  "productName": "FRIDAY",
  "directories": {
    "output": "dist-release"
  },
  "files": [
    "dist-electron/**/*",
    "dist-renderer/**/*",
    "package.json"
  ],
  "win": {
    "signAndEditExecutable": false,
    "target": ["nsis", "dir"]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "FRIDAY",
    "deleteAppDataOnUninstall": false
  }
}
