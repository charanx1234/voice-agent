{
  "appId": "com.friday.ai.companion",
  "productName": "FRIDAY",
  "asar": false,
  "directories": {
    "output": "dist-release",
    "buildResources": "build"
  },
  "files": [
    "dist-electron/**/*",
    "dist-renderer/**/*",
    "src/services/voiceflow/voiceflowEngine.py",
    "package.json"
  ],
  "win": {
    "signAndEditExecutable": true,
    "target": ["nsis", "dir"],
    "icon": "src/renderer/public/assets/friday.ico",
    "legalTrademarks": "FRIDAY — Multilingual Desktop AI Companion",
    "publisherName": "Friday AI Companion Team"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "FRIDAY",
    "deleteAppDataOnUninstall": false,
    "include": "build/installer.nsh"
  }
}
